#!/usr/bin/env bash

# Scipion GPU Wrapper

set -euo pipefail

SCIPION_HOME="${SCIPION_HOME:-/opt/scipion}"
VGLD="${VGL_DEVICE:-/dev/dri/card0}"

if ! command -v vglrun >/dev/null 2>&1; then
  echo "Error: vglrun not found - is VirtualGL installed?" >&2
  exit 1
fi

if [ ! -x "${SCIPION_HOME}/scipion3" ]; then
  echo "Error: ${SCIPION_HOME}/scipion3 not found or not executable" >&2
  exit 1
fi

exec vglrun -d "${VGLD}" "${SCIPION_HOME}/scipion3" "$@"
